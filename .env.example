# Copy to .env and fill in. Nothing here is required for the app to run.

# Port the API listens on, on the host's loopback interface (for a host-level cloudflared)
API_PORT=8093

# Public URL of the site (canonical link, sitemap.xml, robots.txt)
SITE_URL=https://ferries.agniv.site

# Worker limits (training uses these; the server is shared)
FERRY_THREADS=2
WORKER_MEM_LIMIT=3g
WORKER_CPUS=2

# Cloudflare tunnel token (only for `docker compose --profile tunnel up`)
CLOUDFLARE_TUNNEL_TOKEN=

# Alert emails when a feed goes stale or changes schema (optional; any SMTP account)
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
